# ============================================================================
# ORBIT HRMS - Web Application Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit the actual .env.local file to version control.
# ============================================================================

# ============================================================================
# API Configuration
# ============================================================================
# Public API URL - the URL where the backend API is accessible from the browser
# This must be accessible from the client's network
# Examples:
#   Development: http://localhost:3001/api
#   Staging: https://api-staging.yourdomain.com/api
#   Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ============================================================================
# Error Tracking & Monitoring (Optional)
# ============================================================================
# Sentry DSN for error tracking (PUBLIC - safe to expose in browser)
# Get your DSN from: https://sentry.io/ -> Create Project
# Must start with https:// and be valid for browser usage
# Optional in development, recommended for production
# Example: "https://xxx@yyy.ingest.sentry.io/123456"
NEXT_PUBLIC_SENTRY_DSN=""
