# ============================================================================
# ORBIT HRMS - Production Environment Variables Template
# ============================================================================
# This file is a TEMPLATE for production environment configuration.
# DO NOT commit actual production secrets to version control.
#
# Use your deployment platform's secret management:
#   - Railway: Railway Secrets
#   - Fly.io: Fly Secrets
#   - Render: Environment Variables
#   - AWS: Secrets Manager, Parameter Store
#   - GCP: Cloud Secret Manager
#   - Azure: Key Vault
#
# Copy values from this template, replace with actual production values,
# and set them in your platform's secret manager.
# ============================================================================

# ============================================================================
# Database Configuration - PRODUCTION
# ============================================================================
# Use managed database service credentials (RDS, Neon, Supabase, etc.)
# Ensure strong passwords are generated and stored securely
DATABASE_URL="postgresql://orbit_app:CHANGE_ME_STRONG_PASSWORD@db.yourdomain.com:5432/orbit_hr?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_ADMIN_PASSWORD@db.yourdomain.com:5432/orbit_hr?schema=public"

# ============================================================================
# Authentication & Security - PRODUCTION
# ============================================================================
# IMPORTANT: Generate NEW secrets for production using:
#   openssl rand -base64 32
# DO NOT reuse development or staging secrets in production.
JWT_SECRET="GENERATE_NEW_PRODUCTION_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="GENERATE_NEW_PRODUCTION_REFRESH_SECRET"

# ============================================================================
# Application Configuration - PRODUCTION
# ============================================================================
NODE_ENV="production"
PORT=3001

# Use your actual production domain
WEB_ORIGIN="https://app.yourdomain.com"

# ============================================================================
# Email Configuration - PRODUCTION
# ============================================================================
# Use Resend or configure SMTP with your production email service
MAIL_SERVICE="resend"
RESEND_API_KEY="re_PRODUCTION_API_KEY_HERE"

# ============================================================================
# Deployment & Public URLs - PRODUCTION
# ============================================================================
# These must be accessible from the internet and match your domain
APP_URL="https://api.yourdomain.com"
WEB_URL="https://app.yourdomain.com"

# ============================================================================
# Logging & Monitoring - PRODUCTION
# ============================================================================
DEBUG_REQUESTS="false"
