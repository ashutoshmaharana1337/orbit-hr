generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  WFH
  ABSENT
}

enum LeaveType {
  ANNUAL
  SICK
  WORK_FROM_HOME
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users            User[]
  employees        Employee[]
  attendanceRecords AttendanceRecord[]
  leaveRequests    LeaveRequest[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  createdAt    DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee?

  @@index([tenantId])
}

model Employee {
  id         String         @id @default(uuid())
  tenantId   String
  userId     String?        @unique
  name       String
  email      String
  title      String
  department String
  location   String
  status     EmployeeStatus @default(ACTIVE)
  managerId  String?
  joinDate   DateTime
  phone      String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeManager")

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leaveBalance      LeaveBalance?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, department])
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  tenantId   String
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  clockIn    DateTime?
  clockOut   DateTime?
  hours      Float            @default(0)
  createdAt  DateTime         @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  tenantId   String
  employeeId String
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  days       Int
  status     LeaveStatus @default(PENDING)
  reason     String
  appliedOn  DateTime    @default(now())
  decidedAt  DateTime?
  decidedBy  String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId])
}

model LeaveBalance {
  id          String @id @default(uuid())
  employeeId  String @unique
  annualUsed  Int    @default(0)
  annualTotal Int    @default(18)
  sickUsed    Int    @default(0)
  sickTotal   Int    @default(10)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
