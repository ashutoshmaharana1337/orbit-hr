generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The app's runtime connection — a restricted role with no BYPASSRLS,
  // so Postgres row-level security actually applies to it.
  url       = env("DATABASE_URL")
  // Only Prisma CLI commands (migrate, generate) use this — the
  // privileged role needed to create the restricted role above, grant
  // it privileges, and manage RLS policies. Never used at app runtime.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  WFH
  ABSENT
}

enum LeaveType {
  ANNUAL
  SICK
  WORK_FROM_HOME
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Tenant {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  timezone          String   @default("UTC")
  lateCutoffMinutes Int      @default(600) // minutes since local midnight, e.g. 600 = 10:00
  createdAt         DateTime @default(now())

  users             User[]
  employees         Employee[]
  departments       Department[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leavePolicies     LeavePolicy[]
  leaveBalances     LeaveBalance[]
  auditLogs         AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  createdAt    DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          Employee?
  refreshTokens     RefreshToken[]
  passwordSetTokens PasswordSetToken[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordSetToken {
  id        String               @id @default(uuid())
  userId    String
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Employee {
  id           String         @id @default(uuid())
  tenantId     String
  userId       String?        @unique
  name         String
  email        String
  title        String
  departmentId String?
  location     String
  status       EmployeeStatus @default(ACTIVE)
  managerId    String?
  joinDate     DateTime
  phone        String
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    Employee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[]  @relation("EmployeeManager")

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, deletedAt])
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  tenantId   String
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  clockIn    DateTime?
  clockOut   DateTime?
  hours      Float            @default(0)
  createdAt  DateTime         @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  tenantId   String
  employeeId String
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  days       Int
  status     LeaveStatus @default(PENDING)
  reason     String
  appliedOn  DateTime    @default(now())
  decidedAt  DateTime?
  decidedBy  String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId])
}

model LeavePolicy {
  id                    String   @id @default(uuid())
  tenantId              String
  name                  String
  workingDaysPerWeek    Int      @default(5)
  publicHolidaysPerYear Int      @default(0)
  entitlementDays       Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LeaveBalance {
  id             String   @id @default(uuid())
  tenantId       String
  employeeId     String
  leavePolicyId  String
  year           Int
  entitledDays   Decimal  @db.Decimal(10, 2)
  usedDays       Decimal  @db.Decimal(10, 2) @default(0)
  balanceDays    Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leavePolicyId, year])
  @@index([tenantId, employeeId])
  @@index([tenantId, year])
}

model AuditLog {
  id                 String      @id @default(uuid())
  tenantId           String
  entityType         String      // "Employee", "LeaveRequest", "LeaveBalance", "Department", "AttendanceRecord"
  entityId           String      // UUID of the entity being changed
  action             AuditAction // CREATE, UPDATE, DELETE
  userId             String?     // who made the change (Employee userId linked)
  userRole           String?     // their role at the time
  beforeValues       Json?       // the row before the change (for UPDATE)
  afterValues        Json?       // the row after the change (for UPDATE, CREATE)
  changeDescription  String?     // human-readable summary if applicable
  timestamp          DateTime    @default(now())
  createdAt          DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, timestamp])
  @@index([tenantId, userId])
}
