# Restricted role, no BYPASSRLS — this is what the app connects as.
DATABASE_URL="postgresql://orbit_app:orbit_app_dev_password@localhost:5432/orbit_hr?schema=public"
# Privileged role, used only by `prisma migrate`/`prisma db` commands to
# create the restricted role above and manage RLS policies.
DIRECT_DATABASE_URL="postgresql://orbit:orbit_dev_password@localhost:5432/orbit_hr?schema=public"
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="15m"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
