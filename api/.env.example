# ============================================================================
# ORBIT HRMS - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to version control.
# For production deployments, use platform-specific secret management.
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
# Restricted role, no BYPASSRLS — this is what the app connects as.
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://orbit_app:orbit_app_dev_password@localhost:5432/orbit_hr?schema=public"

# Privileged role, used only by `prisma migrate deploy` and `prisma db` commands.
# This user must have DDL permissions to create tables, indexes, and roles.
# Format: postgresql://username:password@host:port/database?schema=public
DIRECT_DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/orbit_hr?schema=public"

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT Secret for signing access tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 32
# NEVER use the same secret in dev/staging/production.
JWT_SECRET="your_super_secure_jwt_secret_min_32_chars_here_12345"

# JWT Token expiration time for access tokens
# Examples: 15m, 1h, 7d
JWT_EXPIRES_IN="15m"

# Refresh Token Secret for signing refresh tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 32
# NEVER use the same secret in dev/staging/production.
REFRESH_TOKEN_SECRET="your_super_secure_refresh_secret_min_32_chars_here"

# ============================================================================
# Application Configuration
# ============================================================================
# Node environment: development, staging, test, production
NODE_ENV="development"

# Server port
PORT=3001

# Frontend origin for CORS and redirect URLs
# Must match the web app's URL
WEB_ORIGIN="http://localhost:3000"

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
# Email service provider (currently supports: resend, smtp)
MAIL_SERVICE="resend"

# For Resend.com API
RESEND_API_KEY=""

# For SMTP Configuration (alternative to Resend)
# MAIL_SERVICE="smtp"
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT="587"
# MAIL_USER="your-email@gmail.com"
# MAIL_PASS="your-app-specific-password"
# MAIL_FROM="noreply@orbithr.com"

# ============================================================================
# Deployment & Public URLs
# ============================================================================
# Application API URL (what clients use to reach the API)
APP_URL="http://localhost:3001"

# Frontend web app URL (for email links, redirects, etc.)
WEB_URL="http://localhost:3000"

# ============================================================================
# Logging & Debug (Optional)
# ============================================================================
# Enable request logging in development
# Values: true, false
DEBUG_REQUESTS="false"
