{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // Roadmap services not registered in any module; they target models/fields
    // (apiLog, supportTicket, Employee.terminationDate, AuditLog.legalHold, ...)
    // that do not exist in prisma/schema.prisma yet, so they cannot type-check.
    "src/common/data-retention.service.ts",
    "src/tenant/tenant-deletion.service.ts"
  ]
}
